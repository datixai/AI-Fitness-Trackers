# Copy to .env for local development
DATABASE_URL="file:./dev.db"
# Long random string used to sign login cookies. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="dev-only-change-me-dev-only-change-me"

# Local development test accounts created by `npm run db:seed` (never use in production)
SEED_PASSWORD="Test1"
SEED_EMAIL="test@email.com"
