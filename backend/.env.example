# ============================================================
# AM CULTURISMO - Environment Variables
# Copy this file to .env and fill in ALL values
# ============================================================

# ---- Server ----
NODE_ENV=development
PORT=3001

# ---- JWT (REQUIRED - min 32 random characters) ----
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS
JWT_EXPIRE=7d

# ---- Database (REQUIRED) ----
# Option A: Connection string (Railway/Render/Supabase)
DATABASE_URL=

# Option B: Individual params (local dev)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=am_culturismo
DB_USER=postgres
DB_PASSWORD=CHANGE_THIS_DB_PASSWORD
DB_POOL_MAX=20

# ---- Bcrypt ----
BCRYPT_ROUNDS=12

# ---- CORS / Frontend URL ----
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# ---- Email (Nodemailer) ----
EMAIL_SERVICE=gmail
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASSWORD=your_gmail_app_password
EMAIL_FROM=noreply@amculturismo.com

# ---- Stripe (EU Payments) ----
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ---- Rate Limiting ----
FORM_SUBMISSION_COOLDOWN_MINUTES=10
